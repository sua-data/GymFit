# 운동 미디어 업로드 제한 (기본 25MB, 영상 60초)
WORKOUT_MEDIA_MAX_BYTES=26214400
WORKOUT_VIDEO_MAX_SECONDS=60

# Pose 개발 디버그 및 저장 영상 테스트(비워두면 기존 카메라 흐름 유지)
POSE_DEBUG=false
POSE_TEST_VIDEO_PATH=
POSE_TEST_EXERCISE=PUSHUP
POSE_TEST_LOOP=false
